/** Shirt class - מייצגת חולצה עם 4 כיווני סיבוב ולוגיקת תנועה מאובטחת */
class Shirt {
    field int x, y, size, actions, rotation;
/** Constructor: Initializes the shirt's position, size, and orientation */
    constructor Shirt new(int Ax, int Ay, int Asize) {
        let x = Ax;
        let y = Ay;
        let size = Asize;
        let actions = 0;
        let rotation = 0; // 0=רגיל, 1=90, 2=180, 3=270
        do draw();
        return this;
    }
/** Draws the shirt based on its current rotation state */
    method void draw() {
        do Screen.setColor(true);
        if ((rotation = 0) | (rotation = 2)) {
            // מצב אנכי
            do Screen.drawRectangle(x, y, x + size, y + (size + 10));
            if (rotation = 0) { // שרוולים למעלה
                do Screen.drawRectangle(x - (size/2), y, x, y + (size/3));
                do Screen.drawRectangle(x + size, y, x + size + (size/2), y + (size/3));
            } else { // שרוולים למטה
                do Screen.drawRectangle(x - (size/2), y + size, x, y + size + (size/3));
                do Screen.drawRectangle(x + size, y + size, x + size + (size/2), y + size + (size/3));
            }
        } else {
            // מצב אופקי
            do Screen.drawRectangle(x, y, x + (size + 10), y + size);
            if (rotation = 1) { // שרוולים לימין
                do Screen.drawRectangle(x + size, y - (size/2), x + size + (size/3), y);
                do Screen.drawRectangle(x + size, y + size, x + size + (size/3), y + size + (size/2));
            } else { // שרוולים לשמאל
                do Screen.drawRectangle(x, y - (size/2), x + (size/3), y);
                do Screen.drawRectangle(x, y + size, x + (size/3), y + size + (size/2));
            }
        }
        return;
    }
 /** Erases the shirt from the screen using the draw logic with white color */
     method void erase() {
        do Screen.setColor(false); // צבע לבן
        // נצייר מלבן לבן שגדול קצת מהחולצה כדי לכסות את כל השרוולים
        do Screen.drawRectangle(x - (size), y - (size), x + size + 20, y + size + 20);
        return;
    }
/** Maps keyboard input to specific actions */
    method void handleKey(char key) {
        if (key = 131) { do move(0, -5); } // Up
        if (key = 133) { do move(0, 5); }  // Down
        if (key = 130) { do move(-5, 0); } // Left
        if (key = 132) { do move(5, 0); }  // Right
        if (key = 82) { do rotate(); }     // R
        if (key = 90) { do changeSize(2); } // Z
        if (key = 88) { do changeSize(-2); } // X
        return;
    }
/** Moves the object and keeps it within the screen boundaries */
    method void move(int dx, int dy) {
        var int margin;
        let margin = size + 15;
        if (((x + dx - margin) > 0) & ((x + dx + margin + 10) < 511) &
            ((y + dy - margin) > 0) & ((y + dy + margin + 10) < 255)) {
            do erase();
            let x = x + dx;
            let y = y + dy;
            let actions = actions + 1;
            do draw();
        }
        return;
    }
/** Cycles through the 4 rotation states */
    method void rotate() {
        do erase();
        let rotation = rotation + 1;
        if (rotation = 4) { let rotation = 0; }
        let actions = actions + 1;
        do draw();
        return;
    }
/** Adjusts the size of the shirt within allowed limits */
method void changeSize(int delta) {
    if (((size + delta) > 10) & ((size + delta) < 60)) {
        do erase();             // 1. קודם כל מוחקים את החולצה בגודל הנוכחי
        let size = size + delta; // 2. רק עכשיו משנים את הגודל
        let actions = actions + 1;
        do draw();              // 3. מציירים את החולצה בגודל החדש
    }
    return;
}
/** Returns total actions performed on this object */
    method int getActionCount() { return actions; }
    /** Memory cleanup */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}