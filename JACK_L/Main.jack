/**
 * Main class for the Jack application.
 */
class Main {
    function void main() {
        var char key;
        var boolean exit;
        var Shirt myShirt;
        var Hippo myHippo;
        var int activeObject; // 1 = Shirt, 2 = Hippo

        let exit = false;
        let activeObject = 1; 
        
        // יצירת האובייקטים
        let myShirt = Shirt.new(256, 128, 40); 
        let myHippo = Hippo.new(100, 100, 20);

        // ציור ראשוני
        do Screen.clearScreen();
        do myShirt.draw();
        do myHippo.draw();
        
        // הדפסת תפריט ראשונית בשתי שורות
        do Output.moveCursor(0,0);
        do Output.printString("S: Shirt, H: Hippo, R: Rotate");
        do Output.println();
        do Output.printString("Z/X: Change Size, Q: Quit");

        // לולאת המשחק הראשית
        while (~exit) {
            let key = Keyboard.keyPressed();

            if (~(key = 0)) { // רק אם נלחץ מקש
                do Screen.clearScreen();

                // זיהוי המקש שנלחץ
                if (key = 81) { let exit = true; }      // 'Q'
                if (key = 83) { let activeObject = 1; } // 'S'
                if (key = 72) { let activeObject = 2; } // 'H'

                // הפעלת הפעולה על האובייקט הנבחר
                if (activeObject = 1) {
                    do myShirt.handleKey(key);
                } else {
                    do myHippo.handleKey(key);
                }
                
                // ציור של שניהם מחדש כדי שאף אחד לא ייעלם
                do myShirt.draw();
                do myHippo.draw();

                // הדפסת התפריט מחדש בשתי שורות (כי המסך נוקה)
                do Output.moveCursor(0,0);
                do Output.printString("S: Shirt, H: Hippo, R: Rotate");
                do Output.println();
                do Output.printString("Z/X: Change Size, Q: Quit");

                // השהייה קטנה ומניעת ריצה מהירה של מקשים (למשל בסיבוב)
                while (~(Keyboard.keyPressed() = 0)) {
                    // מחכה עד שהמשתמש יעזוב את המקש
                }
            }
        }

        // ניקוי זיכרון בסיום
        do myShirt.dispose();
        do myHippo.dispose();

        return;
    }
}